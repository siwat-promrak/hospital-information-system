{
  "name": "@hospital/api",
  "version": "0.0.0",
  "private": true,
  "description": "Hospital Information System — backend API (NestJS)",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "echo \"lint placeholder — ESLint not yet configured\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "db:seed": "ts-node -P tsconfig.json prisma/seed/index.ts",
    "prisma": "prisma"
  },
  "prisma": {
    "seed": "ts-node -P tsconfig.json prisma/seed/index.ts"
  },
  "dependencies": {
    "@nestjs/common": "10.4.22",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/swagger": "7.4.2",
    "@nestjs/terminus": "10.3.0",
    "@prisma/client": "5.22.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "compression": "1.8.1",
    "dayjs": "1.11.13",
    "helmet": "7.2.0",
    "jose": "5.9.6",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.22",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/node": "20.19.41",
    "@types/supertest": "6.0.3",
    "jest": "29.7.0",
    "prisma": "5.22.0",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "ts-loader": "9.5.7",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
