# Backend API environment variables
# Copy to .env and fill in real values

# HTTP port the NestJS server listens on
PORT=3001

# Node environment: development | test | production
NODE_ENV=development

# CORS allow-list (comma-separated origins). Use "*" to allow all.
# Example: CORS_ORIGIN=http://localhost:3000,https://app.example.com
CORS_ORIGIN=http://localhost:3000

# Postgres connection string (host port 5434 → container 5432; see docker-compose.yml)
DATABASE_URL=postgresql://his:his@localhost:5434/his?schema=public

# Shared HS256 secret used by NextAuth (web) to sign session JWTs and by the
# API to verify them. Must be identical across web and api.
NEXTAUTH_SECRET=dev-nextauth-secret-change-me

# Shared secret used on internal server-to-server calls (Next.js server →
# NestJS) such as POST /auth/resolve. Must be identical across web and api.
INTERNAL_API_SECRET=dev-internal-api-secret-change-me

# Comma-separated email domains automatically granted role=STAFF on first
# sign-in. Anything else becomes role=PATIENT.
STAFF_ALLOWED_DOMAINS=gmail.com
