# Backend API environment variables
# Copy to .env and fill in real values

# HTTP port the NestJS server listens on
PORT=3001

# Node environment: development | test | production
NODE_ENV=development

# CORS allow-list (comma-separated origins). Use "*" to allow all.
# Example: CORS_ORIGIN=http://localhost:3000,https://app.example.com
CORS_ORIGIN=http://localhost:3000

# Postgres connection string (used later when Prisma is wired up)
DATABASE_URL=postgresql://his_user:his_password@localhost:5434/his_db?schema=public
