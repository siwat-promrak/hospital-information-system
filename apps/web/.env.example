NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend internal URL — used by the Next.js server (signIn callback,
# /api/be/* rewrite). NOT exposed to the browser; the BE never receives
# direct client traffic.
BACKEND_INTERNAL_URL=http://localhost:3001

# Shared secret used on internal server-to-server calls
# (Next.js server → NestJS). Must match `INTERNAL_API_SECRET` in apps/api/.env.
INTERNAL_API_SECRET=dev-internal-api-secret-change-me

# HS256 secret signing the NextAuth session JWT. Must match
# `NEXTAUTH_SECRET` in apps/api/.env so the BE can verify the cookie.
NEXTAUTH_SECRET=dev-nextauth-secret-change-me

# Google OAuth client credentials. Authorized redirect URI must be
# http://localhost:3000/api/auth/callback/google in dev.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional NextAuth session lifetime overrides (in SECONDS).
# Code defaults: 7 days (max-age) + 1 hour (update-age) — see
# src/auth/auth.const.ts. Set these to tighten rotation in production
# without a code change. SESSION_UPDATE_AGE_SECONDS MUST be strictly
# less than SESSION_MAX_AGE_SECONDS.
# SESSION_MAX_AGE_SECONDS=604800
# SESSION_UPDATE_AGE_SECONDS=3600
